<Page
    x:Class="ClaudeDesktopTools.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" MaxWidth="700" HorizontalAlignment="Left">
            <!-- Header -->
            <StackPanel Spacing="6">
                <TextBlock Text="Ajustes de Retención y Preferencias" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Configura los umbrales de retención local para Claude CLI y Claude Desktop."
                           Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Retention Settings Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Umbrales de Retención" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Retención de Transcripts CLI (Días):" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Los transcripts anteriores a este plazo se clasificarán como recuperables."
                                   Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <NumberBox Value="{x:Bind ViewModel.TranscriptRetentionDays, Mode=TwoWay}" Minimum="0" Maximum="365" Width="160" HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Retención de Sesiones Desktop (Días):" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Las sesiones anteriores a este plazo se marcarán para archivar en la lista."
                                   Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <NumberBox Value="{x:Bind ViewModel.SessionRetentionDays, Mode=TwoWay}" Minimum="0" Maximum="365" Width="160" HorizontalAlignment="Left" />
                    </StackPanel>

                    <Button Command="{x:Bind ViewModel.SaveSettingsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" />
                            <TextBlock Text="Guardar Ajustes" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="{x:Bind ViewModel.SaveMessage, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>

            <!-- About Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="Acerca de Claude Desktop Tools" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Versión 1.0.0 · Desarrollado con WinUI 3 y .NET 9" Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock Text="Diseñado para proporcionar soberanía sobre los datos generados localmente por modelos de IA y herramientas de desarrollo."
                               Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
