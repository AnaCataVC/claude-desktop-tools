<Page
    x:Class="ClaudeDesktopTools.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="24" MaxWidth="700" HorizontalAlignment="Left">
            <!-- Header -->
            <StackPanel Spacing="6">
                <TextBlock Text="Ajustes de Retención y Preferencias" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock Text="Configura los umbrales de retención local para Claude CLI y Claude Desktop."
                           Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- Retention Settings Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Umbrales de Retención" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Retención de Transcripts CLI (Días):" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Los transcripts anteriores a este plazo se clasificarán como recuperables."
                                   Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <NumberBox Value="{x:Bind ViewModel.TranscriptRetentionDays, Mode=TwoWay}" Minimum="0" Maximum="365" Width="160" HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Retención de Sesiones Desktop (Días):" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="Las sesiones anteriores a este plazo se marcarán para archivar en la lista."
                                   Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <NumberBox Value="{x:Bind ViewModel.SessionRetentionDays, Mode=TwoWay}" Minimum="0" Maximum="365" Width="160" HorizontalAlignment="Left" />
                    </StackPanel>

                    <Button Command="{x:Bind ViewModel.SaveSettingsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;" />
                            <TextBlock Text="Guardar Ajustes" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="{x:Bind ViewModel.SaveMessage, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>

            <!-- Google Drive Sync Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Copia de Seguridad en Google Drive" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Respalda CLAUDE.md/references, skills, agentes, tareas programadas y hooks sin seguimiento en git a una carpeta de Google Drive, vía un Google Apps Script Web App (sin OAuth)."
                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

                    <TextBox Header="URL de la Web App (termina en /exec)"
                             PlaceholderText="https://script.google.com/macros/s/AKfycb.../exec"
                             Text="{x:Bind ViewModel.DriveWebAppUrl, Mode=TwoWay}" />

                    <PasswordBox Header="Token de autenticación (opcional, si el script lo exige)"
                                 Password="{x:Bind ViewModel.DriveAuthToken, Mode=TwoWay}" />

                    <TextBox Header="Prefijo de carpeta destino en Drive"
                             Text="{x:Bind ViewModel.DriveDestinationPrefix, Mode=TwoWay}" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Nombres de carpeta para archivos sin repositorio Git" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="CLAUDE.md y references sueltos van a la primera carpeta; skills, agentes, tareas programadas y hooks sueltos van a la segunda."
                                   Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        <TextBox Header="Carpeta para CLAUDE.md/references sin repo"
                                 Text="{x:Bind ViewModel.DriveNoRepoBucketName, Mode=TwoWay}" Margin="0,4,0,0" />
                        <TextBox Header="Carpeta para skills/agentes/hooks sin repo"
                                 Text="{x:Bind ViewModel.DriveClaudeConfigBucketName, Mode=TwoWay}" Margin="0,8,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Command="{x:Bind ViewModel.SaveDriveSettingsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE74E;" />
                                <TextBlock Text="Guardar configuración de Drive" />
                            </StackPanel>
                        </Button>
                        <Button Command="{x:Bind ViewModel.TestDriveConnectionCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE701;" />
                                <TextBlock Text="Probar Conexión" />
                            </StackPanel>
                        </Button>
                        <ProgressRing IsActive="{x:Bind ViewModel.IsTestingDriveConnection, Mode=OneWay}" Width="20" Height="20" />
                    </StackPanel>

                    <TextBlock Text="{x:Bind ViewModel.DriveSaveMessage, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                    <TextBlock Text="{x:Bind ViewModel.DriveStatusMessage, Mode=OneWay}"
                               Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- About Card -->
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="Acerca de Claude Desktop Tools" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="Versión 1.2.0 · Desarrollado con WinUI 3 y .NET 9" Style="{ThemeResource CaptionTextBlockStyle}" />
                    <TextBlock Text="Diseñado para proporcionar soberanía sobre los datos generados localmente por modelos de IA y herramientas de desarrollo."
                               Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
