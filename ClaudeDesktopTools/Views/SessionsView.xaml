<Page
    x:Class="ClaudeDesktopTools.Views.SessionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ClaudeDesktopTools.Models"
    xmlns:local="using:ClaudeDesktopTools.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto, Auto, Auto, *">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,16">
            <TextBlock Text="Explorador de Sesiones de Claude Code" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Sesiones de la CLI por carpeta de proyecto, según sus transcripts en el perfil, y su estado de retención."
                       Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Action Bar -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <Button Command="{x:Bind ViewModel.LoadSessionsCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" />
                    <TextBlock Text="Actualizar Lista" />
                </StackPanel>
            </Button>
            <ProgressRing IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" Width="20" Height="20" />
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" VerticalAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Bulk Delete Bar (inactive sessions only) -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="20" Margin="0,0,0,16" VerticalAlignment="Center">
            <Button Click="DeleteAllInactive_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" />
                    <TextBlock Text="Eliminar todas las inactivas" />
                </StackPanel>
            </Button>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Eliminar inactivas de más de" VerticalAlignment="Center" Style="{ThemeResource BodyTextBlockStyle}" />
                <NumberBox Value="{x:Bind ViewModel.BulkDeleteOlderThanDays, Mode=TwoWay}" Minimum="0" Maximum="365" Width="80"
                           SpinButtonPlacementMode="Compact" />
                <TextBlock Text="días" VerticalAlignment="Center" Style="{ThemeResource BodyTextBlockStyle}" />
                <Button Click="DeleteInactiveOlderThan_Click" ToolTipService.ToolTip="Eliminar las sesiones inactivas con más de esa antigüedad">
                    <FontIcon Glyph="&#xE74D;" />
                </Button>
            </StackPanel>
        </StackPanel>

        <!-- Sessions List -->
        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Sessions, Mode=OneWay}"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ClaudeSessionItem">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,4">
                        <Grid ColumnDefinitions="*, Auto, Auto, Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{x:Bind SessionName}" Style="{ThemeResource BodyStrongTextBlockStyle}"
                                           Visibility="{x:Bind local:SessionsView.BoolToVisibility(HasSessionName), Mode=OneWay}" />
                                <TextBlock Text="{x:Bind WorkingDirectory}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind SessionId}" Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0" Spacing="2">
                                <TextBlock Text="{x:Bind FileSizeDisplay}" Style="{ThemeResource CaptionTextBlockStyle}" HorizontalAlignment="Right" />
                                <TextBlock Text="{x:Bind LastModified}" Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                            </StackPanel>

                            <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="4" Padding="8,4" Margin="0,0,8,0"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <TextBlock Text="{x:Bind StatusBadge}" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                            </Border>

                            <Button Grid.Column="3" VerticalAlignment="Center" Tag="{x:Bind}"
                                    Visibility="{x:Bind local:SessionsView.BoolToVisibility(IsActive), Mode=OneWay}"
                                    Click="CloseSession_Click"
                                    ToolTipService.ToolTip="Termina el proceso de Claude Code de esta sesión">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE711;" />
                                    <TextBlock Text="Cerrar sesión" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="3" VerticalAlignment="Center" Tag="{x:Bind}"
                                    Visibility="{x:Bind local:SessionsView.BoolToVisibility(NotActive), Mode=OneWay}"
                                    Click="DeleteTranscript_Click"
                                    ToolTipService.ToolTip="Elimina el transcript de esta sesión para liberar espacio">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" />
                                    <TextBlock Text="Liberar espacio" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
