<Page
    x:Class="ClaudeDesktopTools.Views.ProcessMonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ClaudeDesktopTools.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto, Auto, Auto, *">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,16">
            <TextBlock Text="Monitoreo de Recursos de Claude" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="RAM y CPU en tiempo real de los procesos claude.exe en ejecución. Las acciones de esta vista sólo afectan procesos de Claude."
                       Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Aggregate Metrics -->
        <Grid Grid.Row="1" ColumnSpacing="16" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="Procesos Activos" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.ProcessCount, Mode=OneWay}" Style="{ThemeResource TitleLargeTextBlockStyle}" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="RAM Total" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.TotalWorkingSetDisplay, Mode=OneWay}" Style="{ThemeResource TitleLargeTextBlockStyle}" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="CPU Total" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.TotalCpuPercentDisplay, Mode=OneWay}"
                               Style="{ThemeResource TitleLargeTextBlockStyle}" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Action Bar -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
            <Button Command="{x:Bind ViewModel.RefreshCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE72C;" />
                    <TextBlock Text="Actualizar Ahora" />
                </StackPanel>
            </Button>
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" VerticalAlignment="Center"
                       Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{x:Bind ViewModel.ActionFeedbackMessage, Mode=OneWay}" VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        </StackPanel>

        <!-- Process List -->
        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.Processes, Mode=OneWay}" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ClaudeProcessInfo">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,4">
                        <Grid ColumnDefinitions="*, Auto, Auto, Auto, Auto">
                            <StackPanel Grid.Column="0" Spacing="4" ToolTipService.ToolTip="{x:Bind WorkingDirectoryTooltip}">
                                <TextBlock Text="{x:Bind SessionLabel}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="{x:Bind ProcessName}" /><Run Text=" · PID " /><Run Text="{x:Bind Pid}" />
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0" Spacing="2">
                                <TextBlock Text="{x:Bind WorkingSetDisplay, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" HorizontalAlignment="Right" />
                                <TextBlock Text="RAM" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0" Spacing="2">
                                <TextBlock Text="{x:Bind CpuPercentDisplay, Mode=OneWay}" Style="{ThemeResource BodyStrongTextBlockStyle}" HorizontalAlignment="Right" />
                                <TextBlock Text="CPU" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                            </StackPanel>

                            <Button Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0" Tag="{x:Bind}"
                                    Click="TrimRam_Click"
                                    ToolTipService.ToolTip="Recorta el working set físico del proceso. Nota: Las páginas volverán a cargarse en memoria cuando Claude las requiera.">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" />
                                    <TextBlock Text="Limpiar RAM" />
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="4" VerticalAlignment="Center" Tag="{x:Bind}"
                                    Click="TogglePriority_Click"
                                    ToolTipService.ToolTip="Alterna la prioridad de CPU del proceso entre Normal y Baja.">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE9D9;" />
                                    <TextBlock Text="{x:Bind PriorityToggleLabel, Mode=OneWay}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
