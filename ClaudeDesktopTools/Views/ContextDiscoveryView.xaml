<Page
    x:Class="ClaudeDesktopTools.Views.ContextDiscoveryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ClaudeDesktopTools.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto, Auto, *">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,16">
            <TextBlock Text="Descubrimiento de Contexto IA (CLAUDE.md)" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Localiza CLAUDE.md, references, skills, agentes, tareas programadas y hooks (con análisis de secretos)."
                       Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Configuration and Action Bar -->
        <StackPanel Grid.Row="1" Spacing="12" Margin="0,0,0,16">
            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12">
                <TextBox Grid.Column="0" Header="Directorio raíz a explorar"
                         Text="{x:Bind ViewModel.TargetDirectory, Mode=TwoWay}" />
                <NumberBox Grid.Column="1" Header="Profundidad máxima"
                           Value="{x:Bind ViewModel.MaxDepth, Mode=TwoWay}" SmallChange="1" Minimum="1" Maximum="6" Width="140" />
                <Button Grid.Column="2" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.DiscoverCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" />
                        <TextBlock Text="Iniciar Búsqueda" />
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Width="20" Height="20" />
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" VerticalAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.SelectAllCommand}" Content="Seleccionar todo" />
                <Button Command="{x:Bind ViewModel.DeselectAllCommand}" Content="Deseleccionar todo" />
                <Button Command="{x:Bind ViewModel.DeselectGitTrackedCommand}" Content="Deseleccionar git-tracked"
                        ToolTipService.ToolTip="Deselecciona los archivos que ya tienen seguimiento git, dejando el resto como está." />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="Seleccionar sólo una categoría" Style="{ThemeResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.AvailableCategories}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button Tag="{x:Bind}" Content="{x:Bind}" Click="SelectOnlyCategory_Click" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Grid.Column="0" Text="Mostrar categorías" Style="{ThemeResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <Button Grid.Column="1" Command="{x:Bind ViewModel.ShowAllCategoriesCommand}" Content="Mostrar todas" />
                </Grid>
                <ItemsControl ItemsSource="{x:Bind ViewModel.CategoryFilters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="12" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:CategoryFilterOption">
                            <CheckBox Content="{x:Bind Category}" IsChecked="{x:Bind IsChecked, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="16,12">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="Auto, Auto, *, Auto">
                        <Button Grid.Column="0"
                                Command="{x:Bind ViewModel.SyncToDriveCommand}"
                                IsEnabled="{x:Bind ViewModel.CanSyncToDrive, Mode=OneWay}"
                                ToolTipService.ToolTip="Configura la Web App de Google Drive en Ajustes para habilitar esto.">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE753;" />
                                <TextBlock Text="Sincronizar sin seguimiento a Drive" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Margin="8,0,0,0"
                                Command="{x:Bind ViewModel.CancelDriveSyncCommand}"
                                Visibility="{x:Bind BoolToVisibility(ViewModel.IsSyncingToDrive), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE71A;" />
                                <TextBlock Text="Cancelar" />
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.DriveSyncStatusMessage, Mode=OneWay}"
                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                   Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center"
                                   Visibility="{x:Bind BoolToVisibility(ViewModel.IsSyncingToDrive), Mode=OneWay}"
                                   Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold">
                            <Run Text="{x:Bind ViewModel.DriveSyncCurrentCount, Mode=OneWay}" />
                            <Run Text="/" />
                            <Run Text="{x:Bind ViewModel.DriveSyncTotalCount, Mode=OneWay}" />
                            <Run Text="archivos" />
                        </TextBlock>
                    </Grid>

                    <StackPanel Spacing="4" Visibility="{x:Bind BoolToVisibility(ViewModel.IsSyncingToDrive), Mode=OneWay}">
                        <ProgressBar Value="{x:Bind ViewModel.DriveSyncProgressPercentage, Mode=OneWay}"
                                     IsIndeterminate="{x:Bind ViewModel.IsDriveSyncIndeterminate, Mode=OneWay}"
                                     Minimum="0" Maximum="100" />
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Grid.Column="0" Text="{x:Bind ViewModel.DriveSyncProgressDetail, Mode=OneWay}"
                                       Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DriveSyncProgressPercentageText, Mode=OneWay}"
                                       Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Discovered Candidates, Grouped by Category -->
        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.GroupedCandidates, Mode=OneWay}"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:CandidateGroup">
                    <Expander Margin="0,12,0,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}">
                        <Expander.Header>
                            <Grid ColumnDefinitions="*, Auto, Auto" HorizontalAlignment="Stretch">
                                <TextBlock Grid.Column="0" Text="{x:Bind Category}" VerticalAlignment="Center"
                                           Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <Button Grid.Column="1" Margin="0,0,8,0" Tag="{x:Bind}" Click="SelectAllInGroup_Click">
                                    <TextBlock Text="Seleccionar todo" />
                                </Button>
                                <Button Grid.Column="2" Tag="{x:Bind}" Click="DeselectAllInGroup_Click">
                                    <TextBlock Text="Ninguno" />
                                </Button>
                            </Grid>
                        </Expander.Header>

                        <ItemsControl ItemsSource="{x:Bind}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ClaudeDiscoveryCandidate">
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,4">
                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto">
                                            <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"
                                                      IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />

                                            <StackPanel Grid.Column="1" Spacing="4">
                                                <TextBlock Text="{x:Bind RelativePath}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind FilePath}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0" Spacing="2">
                                                <TextBlock Text="{x:Bind SizeDisplay}" Style="{ThemeResource CaptionTextBlockStyle}" HorizontalAlignment="Right" />
                                                <TextBlock Text="{x:Bind LastModified}" Style="{ThemeResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                                            </StackPanel>

                                            <Border Grid.Column="3" VerticalAlignment="Center" CornerRadius="4" Padding="8,4"
                                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                                <TextBlock Text="{x:Bind StatusBadge}"
                                                           Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
