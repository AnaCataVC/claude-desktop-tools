<Page
    x:Class="ClaudeDesktopTools.Views.ContextDiscoveryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ClaudeDesktopTools.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto, Auto, *">
        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,16">
            <TextBlock Text="Descubrimiento de Contexto IA (CLAUDE.md)" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="Localiza instrucciones de proyecto y referencias de arquitectura con análisis de secretos."
                       Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Configuration and Action Bar -->
        <StackPanel Grid.Row="1" Spacing="12" Margin="0,0,0,16">
            <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="12">
                <TextBox Grid.Column="0" Header="Directorio raíz a explorar"
                         Text="{x:Bind ViewModel.TargetDirectory, Mode=TwoWay}" />
                <NumberBox Grid.Column="1" Header="Profundidad máxima"
                           Value="{x:Bind ViewModel.MaxDepth, Mode=TwoWay}" SmallChange="1" Minimum="1" Maximum="6" Width="140" />
                <Button Grid.Column="2" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.DiscoverCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE721;" />
                        <TextBlock Text="Iniciar Búsqueda" />
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Width="20" Height="20" />
                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" VerticalAlignment="Center"
                           Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </StackPanel>

        <!-- Discovered Candidates List -->
        <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Candidates, Mode=OneWay}"
                  SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ClaudeDiscoveryCandidate">
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="6" Padding="16,12" Margin="0,4">
                        <Grid ColumnDefinitions="*, Auto, Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="{x:Bind RelativePath}" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="{x:Bind FilePath}" Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0" Spacing="2">
                                <TextBlock Text="{x:Bind SizeDisplay}" Style="{ThemeResource CaptionTextBlockStyle}" HorizontalAlignment="Right" />
                                <TextBlock Text="{x:Bind LastModified}" Style="{ThemeResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Right" />
                            </StackPanel>

                            <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="4" Padding="8,4"
                                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                                <TextBlock Text="{x:Bind StatusBadge}"
                                           Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
