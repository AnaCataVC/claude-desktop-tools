<Window
    x:Class="ClaudeDesktopTools.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:ClaudeDesktopTools.Views"
    Title="Claude Desktop Tools">

    <Grid>
        <NavigationView
            x:Name="NavView"
            PaneDisplayMode="Left"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="NavView_SelectionChanged"
            Loaded="NavView_Loaded">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Dashboard" Tag="Dashboard" Icon="Home" />
                <NavigationViewItem Content="Sesiones de Claude" Tag="Sessions" Icon="Library" />
                <NavigationViewItem Content="Contexto IA (CLAUDE.md)" Tag="Context" Icon="Find" />
                <NavigationViewItem Content="Monitoreo de Recursos" Tag="ProcessMonitor">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Ajustes" Tag="Settings" Icon="Setting" />
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" Margin="24,16,24,24" />
        </NavigationView>
    </Grid>
</Window>
