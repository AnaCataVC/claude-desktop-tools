<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\ClaudeDesktopTools\Models\*.cs" Link="Models\%(Filename)%(Extension)" />
    <Compile Include="..\ClaudeDesktopTools\Helpers\LocalSettingsHelper.cs" Link="Helpers\LocalSettingsHelper.cs" />
    <Compile Include="..\ClaudeDesktopTools\Services\Interfaces\*.cs" Link="Services\Interfaces\%(Filename)%(Extension)" />
    <Compile Include="..\ClaudeDesktopTools\Services\*.cs" Link="Services\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

</Project>
